# 凱基證券 API 憑證設定範本。
# 使用方式：複製本檔為 .env（.env 已加入 .gitignore，不會被上傳），並填入您自己的資料。
# 電子憑證本身無需在此填路徑——KGI API 是以本機已安裝的憑證 + 身分證字號 + 密碼進行驗證，
# 因此必須在「已完成憑證安裝」的同一台電腦上執行。

# 身分證字號（登入用帳號）
KGI_PERSON_ID=

# 密碼
KGI_PERSON_PWD=

# 交易帳號（可先留空，登入後用 list_accounts() 查詢再填入）
KGI_TRADE_ACCOUNT=

# 本專案僅使用報價與庫存查詢，不含下單功能。
# true=連線至虛擬環境（預設）；false=連線至正式環境。
# 若要查詢「真實庫存」，通常需設為 false，才會反映實際帳戶部位。
KGI_SIMULATION=true

# ---- Email 每日通知設定（v5.0） ----
# 寄件 Gmail 帳號
EMAIL_ADDRESS=

# Google 帳戶「應用程式密碼」（16碼，非登入密碼）
# 產生方式：Google 帳戶 → 安全性 → 兩步驟驗證（需先開啟）→ 應用程式密碼
EMAIL_APP_PASSWORD=

# 收件信箱（留空預設寄給自己 EMAIL_ADDRESS）
EMAIL_TO=

# SMTP 主機/連接埠（預設 Gmail，若用其他信箱供應商可自行修改）
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ---- LINE 每日通知設定（v5.0，選用） ----
# LINE Notify 已於 2025/03/31 終止服務，改用 LINE Messaging API。
# 取得方式：
#   1. 前往 https://manager.line.biz 建立一個 LINE 官方帳號（免費方案即可）
#   2. 該官方帳號設定 → Messaging API → 啟用
#   3. 前往 https://developers.line.biz 找到對應 Channel → Messaging API 頁籤 → 發行 Channel access token
#   4. 用手機 LINE 掃官方帳號 QR Code 加為好友（Broadcast 只會送給已加好友的人）
LINE_CHANNEL_ACCESS_TOKEN=

# ---- 短線輪動觀察收件人（spouse_report.py，選用） ----
# 要接收「短線類股輪動觀察」的信箱（例如家人）。使用者本人會透過 BCC 收到一份副本。
SPOUSE_EMAIL=

# ---- 個人短期目標基準（portfolio.py，選用） ----
# 設定目標當下的真實總市值（新台幣），做為一年後獲利目標與市值下限的基準。
# 留空則目標追蹤功能會顯示 0，不會出錯，只是數字沒有意義。
GOAL_BASELINE_VALUE=
